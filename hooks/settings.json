{
  "_comment": "Merge these keys into ~/.claude/settings.json (user-level = applies to ALL projects). Replace HUB_PATH with the absolute path to this repo.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "HUB_PATH/bin/llmw session-start" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "HUB_PATH/bin/llmw session-end" }
        ]
      }
    ]
  }
}
